
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>All Users | User Management</title>

    <link rel="stylesheet" href="/showUsers.css">
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar">

        <div class="nav-brand">
            <div class="brand-icon">U</div>
            <h1>User Management</h1>
        </div>

        <a href="/" class="nav-home-btn">
            <span>←</span>
            Dashboard
        </a>

    </nav>


    <!-- Main Content -->
    <main class="users-container">

        <!-- Page Heading -->
        <section class="users-header">

            <div>
                <p class="page-label">USER MANAGEMENT</p>
                <h2>All Users</h2>
                <p class="users-subtitle">
                    View and manage all registered users.
                </p>
            </div>

            <div class="user-count">
                <span>Total Users</span>
                <strong><%= users.length %></strong>
            </div>

        </section>


        <!-- Users Table -->
        <section class="table-card">

            <div class="table-heading">
                <h3>Registered Users</h3>
                <span class="table-description">
                    User directory
                </span>
            </div>


            <% if (users.length > 0) { %>

                <div class="table-wrapper">

                    <table class="users-table">

                        <thead>
                            <tr>
                                <th>User ID</th>
                                <th>Username</th>
                                <th>Email Address</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% for (let user of users) { %>

                                <tr>

                                    <!-- User ID -->
                                    <td>
                                        <span class="user-id">
                                            <%= user.id %>
                                        </span>
                                    </td>


                                    <!-- Username -->
                                    <td>
                                        <div class="user-name">

                                            <div class="user-avatar">
                                                <%= user.username.charAt(0).toUpperCase() %>
                                            </div>

                                            <strong>
                                                <%= user.username %>
                                            </strong>

                                        </div>
                                    </td>


                                    <!-- Email -->
                                    <td>
                                        <span class="user-email">
                                            <%= user.email %>
                                        </span>
                                    </td>


                                    <!-- Actions -->
                                    <td>

                                        <div class="action-buttons">

                                            <!-- Edit Button -->
                                            <a
                                                href="/user/<%= user.id %>/edit"
                                                class="edit-btn"
                                            >
                                                <span>✎</span>
                                                Edit
                                            </a>


                                            <!-- Delete Form -->
                                            <form
                                                action="/user/<%= user.id %>?_method=DELETE"
                                                method="POST"
                                                class="delete-form"
                                                onsubmit="return confirmDelete(this);"
                                            >

                                                <input
                                                    type="password"
                                                    name="password"
                                                    placeholder="Enter password"
                                                    required
                                                    class="delete-password"
                                                >

                                                <button
                                                    type="submit"
                                                    class="delete-btn"
                                                >
                                                    <span>✕</span>
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>


            <% } else { %>


                <!-- Empty State -->
                <div class="empty-state">

                    <div class="empty-icon">👥</div>

                    <h3>No Users Found</h3>

                    <p>
                        There are currently no registered users.
                    </p>

                    <a href="/" class="back-dashboard-btn">
                        Back to Dashboard
                    </a>

                </div>


            <% } %>

        </section>


        <!-- Footer -->
        <footer class="footer">
            <p>User Management System | Built with Node.js & MySQL</p>
        </footer>

    </main>


    <!-- Delete Confirmation -->
    <script>
        function confirmDelete(form) {

            return confirm(
                "Are you sure you want to delete this user?"
            );

        }
    </script>

</body>
</html>
